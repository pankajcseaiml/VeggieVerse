# ============================================================
# VeggieVerse / Green Bites — Environment Configuration
# ============================================================
# This file is SAFE TO COMMIT — it contains NO real secrets.
# Copy this file to .env and fill in your actual values:
#
#   cp .env.example .env          (Linux/macOS)
#   copy .env.example .env        (Windows CMD)
#   Copy-Item .env.example .env   (Windows PowerShell)
#
# The real .env file is git-ignored and must NEVER be committed.
# Store your actual values in a secure password manager.
# ============================================================

# ── Flask Application ────────────────────────────────────────
# Generate a strong random key:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# ── MySQL Database ───────────────────────────────────────────
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=veg_restaurant_db
MYSQL_PORT=3306

# ── Application Settings ─────────────────────────────────────
FLASK_ENV=development
FLASK_DEBUG=1
FLASK_PORT=5000

# ── Disaster Recovery & Backup Encryption ─────────────────────
# 32-byte hex key for AES-256-GCM database backup encryption.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
BACKUP_ENCRYPTION_KEY=

